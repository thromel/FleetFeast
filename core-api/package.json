{
  "name": "@foodpanda/core-api",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript modular core service",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "node --watch --loader ts-node/esm src/main.ts",
    "test": "npm run build && node --test \"dist/**/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^24.10.13",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
