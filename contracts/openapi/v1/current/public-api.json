{
  "openapi": "3.0.3",
  "info": {
    "title": "FoodPanda Public API",
    "version": "1.1.0"
  },
  "paths": {
    "/api/v1/consumer/baskets": {
      "post": {
        "summary": "Create basket",
        "operationId": "createBasket",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BasketCreateRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Basket created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BasketResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/consumer/quotes": {
      "post": {
        "summary": "Generate quote",
        "operationId": "generateQuote",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuoteRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Quote generated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuoteResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Basket not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/consumer/checkout": {
      "post": {
        "summary": "Prepare checkout payload",
        "operationId": "createCheckout",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckoutRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Checkout ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckoutResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Stale quote",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/consumer/orders": {
      "post": {
        "summary": "Create order",
        "operationId": "createOrder",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrderCreateRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Order created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Checkout conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/merchant/catalog/menus": {
      "post": {
        "summary": "Create menu",
        "operationId": "createMenu",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MenuCreateRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Menu created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MenuResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/merchant/payouts": {
      "get": {
        "summary": "List merchant payout statements",
        "operationId": "listMerchantPayouts",
        "responses": {
          "200": {
            "description": "Payout statement list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PayoutStatementListResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/v1/courier/payouts": {
      "get": {
        "summary": "List courier payout statements",
        "operationId": "listCourierPayouts",
        "responses": {
          "200": {
            "description": "Payout statement list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PayoutStatementListResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/payouts/generate": {
      "post": {
        "summary": "Generate payout batch",
        "operationId": "generatePayoutBatch",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PayoutBatchGenerateRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Payout generation accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PayoutBatchGenerateResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/risk/reviews/{reviewId}/resolve": {
      "post": {
        "summary": "Resolve risk manual review",
        "operationId": "resolveRiskReview",
        "parameters": [
          {
            "name": "reviewId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RiskReviewResolveRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Review resolved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RiskReviewResolveResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Review not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Already resolved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/health": {
      "get": {
        "summary": "Admin health endpoint",
        "operationId": "adminHealth",
        "responses": {
          "200": {
            "description": "Service healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminHealthResponse"
                }
              }
            }
          },
          "500": {
            "description": "Service unhealthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "required": [
          "code",
          "message",
          "traceId"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "traceId": {
            "type": "string"
          },
          "details": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "Address": {
        "type": "object",
        "required": [
          "line1",
          "city",
          "state",
          "postalCode",
          "countryCode"
        ],
        "properties": {
          "line1": {
            "type": "string"
          },
          "line2": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "postalCode": {
            "type": "string"
          },
          "countryCode": {
            "type": "string"
          }
        }
      },
      "Money": {
        "type": "object",
        "required": [
          "amount",
          "currency"
        ],
        "properties": {
          "amount": {
            "type": "number"
          },
          "currency": {
            "type": "string"
          }
        }
      },
      "BasketItem": {
        "type": "object",
        "required": [
          "itemId",
          "quantity"
        ],
        "properties": {
          "itemId": {
            "type": "string"
          },
          "quantity": {
            "type": "integer"
          },
          "specialInstructions": {
            "type": "string"
          }
        }
      },
      "BasketCreateRequest": {
        "type": "object",
        "required": [
          "consumerId",
          "merchantId",
          "currency",
          "items"
        ],
        "properties": {
          "consumerId": {
            "type": "string"
          },
          "merchantId": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BasketItem"
            }
          }
        }
      },
      "BasketResponse": {
        "type": "object",
        "required": [
          "basketId",
          "consumerId",
          "merchantId",
          "currency",
          "items",
          "status"
        ],
        "properties": {
          "basketId": {
            "type": "string"
          },
          "consumerId": {
            "type": "string"
          },
          "merchantId": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BasketItem"
            }
          },
          "status": {
            "type": "string"
          }
        }
      },
      "QuoteRequest": {
        "type": "object",
        "required": [
          "basketId",
          "deliveryAddress"
        ],
        "properties": {
          "basketId": {
            "type": "string"
          },
          "deliveryAddress": {
            "$ref": "#/components/schemas/Address"
          },
          "promoCode": {
            "type": "string"
          }
        }
      },
      "QuoteResponse": {
        "type": "object",
        "required": [
          "quoteId",
          "basketId",
          "total",
          "deliveryFee",
          "tax",
          "status"
        ],
        "properties": {
          "quoteId": {
            "type": "string"
          },
          "basketId": {
            "type": "string"
          },
          "total": {
            "$ref": "#/components/schemas/Money"
          },
          "deliveryFee": {
            "$ref": "#/components/schemas/Money"
          },
          "tax": {
            "$ref": "#/components/schemas/Money"
          },
          "status": {
            "type": "string"
          },
          "etaMinutes": {
            "type": "integer"
          }
        }
      },
      "CheckoutRequest": {
        "type": "object",
        "required": [
          "basketId",
          "quoteId",
          "quoteSnapshotHash",
          "paymentMethod"
        ],
        "properties": {
          "basketId": {
            "type": "string"
          },
          "quoteId": {
            "type": "string"
          },
          "quoteSnapshotHash": {
            "type": "string"
          },
          "paymentMethod": {
            "type": "string"
          },
          "clientVersion": {
            "type": "string"
          }
        }
      },
      "CheckoutResponse": {
        "type": "object",
        "required": [
          "checkoutId",
          "quoteId",
          "expiresAt",
          "status"
        ],
        "properties": {
          "checkoutId": {
            "type": "string"
          },
          "quoteId": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "OrderCreateRequest": {
        "type": "object",
        "required": [
          "checkoutId",
          "idempotencyKey"
        ],
        "properties": {
          "checkoutId": {
            "type": "string"
          },
          "idempotencyKey": {
            "type": "string"
          }
        }
      },
      "OrderResponse": {
        "type": "object",
        "required": [
          "orderId",
          "status",
          "quoteId",
          "createdAt"
        ],
        "properties": {
          "orderId": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "quoteId": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "timelineVersion": {
            "type": "integer"
          }
        }
      },
      "MenuItem": {
        "type": "object",
        "required": [
          "itemId",
          "name",
          "price"
        ],
        "properties": {
          "itemId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "price": {
            "$ref": "#/components/schemas/Money"
          }
        }
      },
      "MenuCreateRequest": {
        "type": "object",
        "required": [
          "merchantId",
          "name",
          "items"
        ],
        "properties": {
          "merchantId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MenuItem"
            }
          }
        }
      },
      "MenuResponse": {
        "type": "object",
        "required": [
          "menuId",
          "merchantId",
          "name",
          "version",
          "status"
        ],
        "properties": {
          "menuId": {
            "type": "string"
          },
          "merchantId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "version": {
            "type": "integer"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "PayoutStatement": {
        "type": "object",
        "required": [
          "statementId",
          "entityType",
          "entityId",
          "amount",
          "status",
          "periodStart",
          "periodEnd"
        ],
        "properties": {
          "statementId": {
            "type": "string"
          },
          "entityType": {
            "type": "string"
          },
          "entityId": {
            "type": "string"
          },
          "amount": {
            "$ref": "#/components/schemas/Money"
          },
          "status": {
            "type": "string"
          },
          "periodStart": {
            "type": "string",
            "format": "date-time"
          },
          "periodEnd": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PayoutStatementListResponse": {
        "type": "object",
        "required": [
          "statements"
        ],
        "properties": {
          "statements": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PayoutStatement"
            }
          },
          "nextCursor": {
            "type": "string"
          }
        }
      },
      "PayoutBatchGenerateRequest": {
        "type": "object",
        "required": [
          "runDate"
        ],
        "properties": {
          "runDate": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "PayoutBatchGenerateResponse": {
        "type": "object",
        "required": [
          "payoutBatchId",
          "runDate",
          "status"
        ],
        "properties": {
          "payoutBatchId": {
            "type": "string"
          },
          "runDate": {
            "type": "string",
            "format": "date"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "RiskReviewResolveRequest": {
        "type": "object",
        "required": [
          "reviewerId",
          "decision",
          "reasonCode"
        ],
        "properties": {
          "reviewerId": {
            "type": "string"
          },
          "decision": {
            "type": "string",
            "enum": [
              "APPROVE",
              "REJECT"
            ]
          },
          "reasonCode": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      },
      "RiskReviewResolveResponse": {
        "type": "object",
        "required": [
          "reviewId",
          "decision",
          "resolvedAt"
        ],
        "properties": {
          "reviewId": {
            "type": "string"
          },
          "decision": {
            "type": "string"
          },
          "resolvedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "AdminHealthResponse": {
        "type": "object",
        "required": [
          "status",
          "generatedAt"
        ],
        "properties": {
          "status": {
            "type": "string"
          },
          "generatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "dependencies": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
