{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foodpanda.dev/contracts/events/v1/payment.authorized.v1.schema.json",
  "title": "payment.authorized.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "eventType",
    "eventVersion",
    "occurredAt",
    "producer",
    "idempotencyKey",
    "correlationId",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "const": "payment.authorized.v1"
    },
    "eventVersion": {
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "string"
    },
    "idempotencyKey": {
      "type": "string"
    },
    "correlationId": {
      "type": "string"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "orderId",
        "paymentIntentId",
        "amount"
      ],
      "properties": {
        "orderId": {
          "type": "string"
        },
        "paymentIntentId": {
          "type": "string"
        },
        "amount": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "amount",
            "currency"
          ],
          "properties": {
            "amount": {
              "type": "number"
            },
            "currency": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
