{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foodpanda.dev/contracts/events/v1/order.created.v1.schema.json",
  "title": "order.created.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "eventType",
    "eventVersion",
    "occurredAt",
    "producer",
    "idempotencyKey",
    "correlationId",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "const": "order.created.v1"
    },
    "eventVersion": {
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "string"
    },
    "idempotencyKey": {
      "type": "string"
    },
    "correlationId": {
      "type": "string"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "orderId",
        "merchantId",
        "consumerId",
        "totals"
      ],
      "properties": {
        "orderId": {
          "type": "string"
        },
        "merchantId": {
          "type": "string"
        },
        "consumerId": {
          "type": "string"
        },
        "totals": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "subtotal",
            "deliveryFee",
            "tax",
            "total"
          ],
          "properties": {
            "subtotal": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "amount",
                "currency"
              ],
              "properties": {
                "amount": {
                  "type": "number"
                },
                "currency": {
                  "type": "string"
                }
              }
            },
            "deliveryFee": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "amount",
                "currency"
              ],
              "properties": {
                "amount": {
                  "type": "number"
                },
                "currency": {
                  "type": "string"
                }
              }
            },
            "tax": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "amount",
                "currency"
              ],
              "properties": {
                "amount": {
                  "type": "number"
                },
                "currency": {
                  "type": "string"
                }
              }
            },
            "total": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "amount",
                "currency"
              ],
              "properties": {
                "amount": {
                  "type": "number"
                },
                "currency": {
                  "type": "string"
                }
              }
            }
          }
        },
        "channel": {
          "type": "string"
        }
      }
    }
  }
}
