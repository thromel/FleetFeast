{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowReadOnlyDescribeActions",
      "Effect": "Allow",
      "Action": [
        "ec2:Describe*",
        "ecs:Describe*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowScopedLogWrite",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": [
        "arn:aws:logs:*:*:log-group:/foodpanda/*:log-stream:*"
      ]
    },
    {
      "Sid": "AllowScopedConfigSecretRead",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "secretsmanager:GetSecretValue"
      ],
      "Resource": [
        "arn:aws:ssm:*:*:parameter/foodpanda/*",
        "arn:aws:secretsmanager:*:*:secret:foodpanda/*"
      ]
    },
    {
      "Sid": "DenyIamMutationAndAccountTakeover",
      "Effect": "Deny",
      "Action": [
        "iam:CreateUser",
        "iam:CreateAccessKey",
        "iam:AttachUserPolicy",
        "iam:PutUserPolicy",
        "organizations:*",
        "account:*"
      ],
      "Resource": "*"
    }
  ]
}
